<Window x:Class="SecureChat.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ứng Dụng Chat An Toàn ElGamal – AES-256-GCM &amp; Chữ Ký Số" 
        Height="750" Width="1200" MinHeight="600" MinWidth="950"
        Background="#0D1117" WindowStartupLocation="CenterScreen">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: AUTHENTICATION & STATUS -->
        <Border Grid.Row="0" Background="#161B22" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#30363D" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="ELGAMAL–AES SECURE CHAT" Foreground="#F0F6FC" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Mã hóa lai ElGamal–AES • Chữ ký số ElGamal–SHA256 • Quản lý khóa" Foreground="#8B949E" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- LOGIN & REGISTER CONTROLS -->
                <StackPanel x:Name="LoginPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Tên:" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                    <TextBox x:Name="TxtUsername" Text="" Width="90" Margin="0,0,8,0" Background="#0D1117" Foreground="#FFF" BorderBrush="#30363D" Padding="3"/>
                    
                    <TextBlock Text="Mật khẩu:" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                    <PasswordBox x:Name="TxtPassword" Password="" Width="100" Margin="0,0,8,0" Background="#0D1117" Foreground="#FFF" BorderBrush="#30363D" Padding="3"/>

                    <TextBlock Text="Server:" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                    <TextBox x:Name="TxtServerUrl" Text="http://localhost:5000" Width="140" Margin="0,0,8,0" Background="#0D1117" Foreground="#FFF" BorderBrush="#30363D" Padding="3"/>

                    <Button x:Name="BtnRegister" Content="📝 Đăng Ký" Click="BtnRegister_Click" Background="#238636" Foreground="#FFF" FontWeight="SemiBold" Padding="10,5" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button x:Name="BtnLogin" Content="🔑 Đăng Nhập" Click="BtnLogin_Click" Background="#1F6FEB" Foreground="#FFF" FontWeight="SemiBold" Padding="10,5" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- LOGGED IN USER STATUS -->
                <StackPanel x:Name="StatusPanel" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLoggedInUser" Text="Alice" Foreground="#3FB950" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#21262D" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtMyFingerprint" Text="FP: --" Foreground="#58A6FF" FontFamily="Consolas" FontSize="11"/>
                    </Border>
                    <Button x:Name="BtnRotateKeys" Content="🔄 Đổi Khóa" Click="BtnRotateKeys_Click" Background="#D29922" Foreground="#000" FontWeight="SemiBold" Padding="8,4" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="BtnLogout" Content="Đăng Xuất" Click="BtnLogout_Click" Background="#30363D" Foreground="#FFF" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: CONTACTS & KEY MGMT -->
            <Border Grid.Column="0" Background="#161B22" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#30363D" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="👥 LIÊN HỆ TRỰC TUYẾN" Foreground="#8B949E" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>

                    <ListBox x:Name="ListContacts" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="ListContacts_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6" Width="220">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UserId}" Foreground="#F0F6FC" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding CombinedFingerprint}" Foreground="#8B949E" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- KEY BACKUP / RESTORE ACTIONS -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Separator Background="#30363D" Margin="0,0,0,10"/>
                        <Button x:Name="BtnExportKeystore" Content="💾 Xuất File Keystore (Backup)" Click="BtnExportKeystore_Click" Background="#21262D" Foreground="#F0F6FC" Padding="6" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,0,6" Cursor="Hand"/>
                        <Button x:Name="BtnImportKeystore" Content="📂 Nạp File Keystore (Restore)" Click="BtnImportKeystore_Click" Background="#21262D" Foreground="#F0F6FC" Padding="6" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER COLUMN: CHAT CONVERSATION -->
            <Border Grid.Column="1" Background="#161B22" CornerRadius="8" Margin="4,0,4,0" BorderBrush="#30363D" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CHAT HEADER -->
                    <Border Grid.Row="0" Background="#21262D" Padding="12" CornerRadius="8,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtCurrentChatWith" Text="Chưa chọn người nhận" Foreground="#F0F6FC" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="TxtRecipientFp" Text="Chọn một liên hệ từ danh sách bên trái để chat E2EE" Foreground="#8B949E" FontSize="11" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <!-- CHAT MESSAGES LIST -->
                    <ScrollViewer x:Name="ScrollMessages" Grid.Row="1" Background="#090D13" Padding="12">
                        <StackPanel x:Name="PanelMessages"/>
                    </ScrollViewer>

                    <!-- ATTACK MODE SELECTOR -->
                    <Border Grid.Row="2" Background="#161B22" Padding="8,6" BorderBrush="#30363D" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chế độ gửi:" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RbNormal" Content="Bình thường" Foreground="#FFF" IsChecked="True" FontSize="11" Margin="0,0,12,0"/>
                            <RadioButton x:Name="RbTamperCipher" Content="⚠️ Sửa Ciphertext" Foreground="#FF7B72" FontSize="11" Margin="0,0,12,0"/>
                            <RadioButton x:Name="RbTamperSig" Content="⚠️ Sửa Chữ ký (r,s)" Foreground="#FF7B72" FontSize="11" Margin="0,0,12,0"/>
                            <RadioButton x:Name="RbTamperAad" Content="⚠️ Sửa Người gửi" Foreground="#FF7B72" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- COMPOSER -->
                    <Border Grid.Row="3" Background="#242526" Padding="12" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnThumbsUp" Grid.Column="0" Content="👍" Click="BtnThumbsUp_Click" Background="Transparent" Foreground="#0084FF" FontSize="18" Padding="6,2" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                            <TextBox x:Name="TxtMessageInput" Grid.Column="1" Background="#3A3B3C" Foreground="#FFF" BorderBrush="#393A3B" Padding="8,8" FontSize="13" Margin="0,0,8,0" KeyDown="TxtMessageInput_KeyDown"/>
                            <Button x:Name="BtnSendMessage" Grid.Column="2" Content="Gửi 🚀" Click="BtnSendMessage_Click" Background="#0084FF" Foreground="#FFF" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: CRYPTO INSPECTOR -->
            <Border Grid.Column="2" Background="#161B22" CornerRadius="8" Padding="14" Margin="8,0,0,0" BorderBrush="#30363D" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔬" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="KÍNH LÚP MẬT MÃ (INSPECTOR)" Foreground="#58A6FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Phân tích trực quan các tham số toán học của tin nhắn đã chọn:" Foreground="#8B949E" FontSize="11" Margin="0,0,0,10"/>

                        <!-- STEP 1 -->
                        <Border Background="#090D13" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="1. Khóa Phiên AES-256 (CSPRNG)" Foreground="#7EE787" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InspSessionKey" Text="Key: --" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InspU" Text="u = OS2IP(K): --" Foreground="#8B949E" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="InspM" Text="m = (u+1)²: --" Foreground="#8B949E" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- STEP 2 -->
                        <Border Background="#090D13" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="2. Khóa ElGamal Bảo Vệ (Chương 2.3)" Foreground="#7EE787" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="WB (Người nhận):" Foreground="#8B949E" FontSize="10"/>
                                <TextBlock x:Name="InspWb" Text="c1, c2: --" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap"/>
                                <TextBlock Text="WA (Người gửi):" Foreground="#8B949E" FontSize="10" Margin="0,4,0,0"/>
                                <TextBlock x:Name="InspWa" Text="c1, c2: --" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- STEP 3 -->
                        <Border Background="#090D13" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="3. AES-256-GCM Payload (Chương 2.2)" Foreground="#7EE787" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InspNonce" Text="Nonce (12B): --" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InspTag" Text="Tag (16B): --" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="InspCipher" Text="Ciphertext: --" Foreground="#8B949E" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- STEP 4 -->
                        <Border Background="#090D13" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="4. Chữ Ký Số ElGamal–SHA256 (Chương 3)" Foreground="#7EE787" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InspSigHash" Text="SHA-256 Hash: --" Foreground="#8B949E" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InspSigR" Text="r = g^k mod p: --" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="InspSigS" Text="s = k^(-1)(h - xr): --" Foreground="#C9D1D9" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="InspSigStatus" Text="Kiểm tra: g^h ≡ y^r • r^s mod p" Foreground="#3FB950" FontWeight="Bold" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
